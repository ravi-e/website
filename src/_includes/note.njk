---
layout: base.njk
---
<article class="prose">
  <div style="margin-bottom: 2rem;">
    <div class="editorial-kicker">Note &bull; {{ date | readableDate }}</div>
    <h1 style="margin-top: 0.5rem; font-size: 1.8rem; line-height: 1.2;">{{ title }}</h1>
  </div>

  {{ content | safe }}

  <div style="margin-top: 3rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
    <a href="/notes/" class="editorial-meta-link">&larr; Back to Notes Archive</a>
  </div>
</article>
