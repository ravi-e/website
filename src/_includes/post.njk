---
layout: base.njk
---
<article class="prose">
  <div style="margin-bottom: 2rem;">
    <div class="editorial-kicker">Writing &bull; {{ date | readableDate }}</div>
    <h1 style="margin-top: 0.5rem; font-size: 2.2rem; line-height: 1.1;">{{ title }}</h1>
  </div>
  
  {{ content | safe }}

  <div style="margin-top: 3rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
    <a href="/writing/" class="editorial-meta-link">&larr; Back to Writing</a>
  </div>
</article>
